node_modules/
bun.lockb
.DS_Store
.idea/
.claude/worktrees/

# --- Sicherheit: niemals Secrets/lokale Daten committen (öffentliches Repo!) ---
.env
*.env
!*.env.example
.secrets-allow.local
# Claude Code legt hier maschinenspezifische Pfade ab (/Users/<name>/...)
.claude/settings.local.json
# Lokale Zeiterfassungs-Daten (lt-time) gehören NIE ins Repo
.lt-time/
**/data/clockodo.json
**/data/calendar.json
**/token.json
**/credentials.json

# claude plugin eval run output (reports, per-run transcripts)
plugins/*/evals/results/
# Judge self-test cases: `node selftest.mjs sync` writes these before each run from selftest.json and the
# measured rubrics. Only selftest.json and the reference outputs are sources.
plugins/*/evals/selftest/*/case.yaml
plugins/*/evals/selftest/*/prompt.md
plugins/*/evals/selftest/*/fixture.sh
plugins/*/evals/selftest/*/graders/

# Project-scoped subagent memory (lt-dev reviewers declare `memory: project`). Their notes
# can describe private repositories and local machines, and this repo is public: keep them
# local. Knowledge worth sharing goes into the plugin elements instead.
.claude/agent-memory/
