{
  "description": "Project detection, safety guards, circuit breaker, file protection, peer-session coordination, and lt-plugin auto-update",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/update-lt-plugins.sh\"",
            "timeout": 5,
            "statusMessage": "Checking lt CLI plugin updates"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/cleanup-stale-chrome-mcp.sh\"",
            "timeout": 10,
            "statusMessage": "Reaping stale chrome-devtools-mcp processes"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-peer-sessions.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for parallel Claude Code sessions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-files.sh\"",
            "timeout": 3,
            "statusMessage": "Checking file protection"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-plugin-frontmatter.sh\"",
            "timeout": 5,
            "statusMessage": "Validating plugin frontmatter",
            "if": "Write(**/*.md)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-plugin-frontmatter.sh\"",
            "timeout": 5,
            "statusMessage": "Validating plugin frontmatter",
            "if": "Edit(**/*.md)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-dangerous-bash.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for dangerous commands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/circuit-breaker-reset.sh\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/vendor-core-edit-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking vendor core policy",
            "if": "Write(**/src/core/**)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/vendor-core-edit-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking vendor core policy",
            "if": "Edit(**/src/core/**)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/vendor-core-edit-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking vendor core policy",
            "if": "Write(**/app/core/**)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/vendor-core-edit-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking vendor core policy",
            "if": "Edit(**/app/core/**)"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/circuit-breaker.sh\"",
            "timeout": 3,
            "statusMessage": "Checking circuit breaker"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-nuxt.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting project context"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-nest-server.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting project context"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-lt-cli.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting project context"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-plugin-dev.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting project context"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-security-context.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting project context"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-npm-maintenance.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting project context"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-lt-dev.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting lt-dev URLs"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/circuit-breaker-cleanup.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/circuit-breaker-cleanup.sh\"",
            "timeout": 1
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-compact-context.sh\"",
            "timeout": 5,
            "statusMessage": "Re-injecting project context"
          }
        ]
      }
    ]
  }
}
