{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/chrome-devtools-mcp-launcher.sh",
      "args": [
        "--isolated"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "nuxt-ui-remote": {
      "type": "http",
      "url": "https://ui.nuxt.com/mcp"
    }
  }
}
