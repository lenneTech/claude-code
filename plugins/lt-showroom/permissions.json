{
  "$schema": "./permissions.schema.json",
  "description": "Bash permissions for the showroom plugin: source code analysis, installing and starting the analysed project through its own package scripts, and read-only checks. Starting extra containers (docker run), curl against the stack and the screenshot-session script are granted per turn by /lt-showroom:showroom:screenshot.",
  "formerPatterns": [
    "Bash(cp *.env*)",
    "Bash(curl *api.showroom.lenne.tech*)",
    "Bash(curl *localhost*)",
    "Bash(cwebp:*)",
    "Bash(docker compose -p showroom-*)",
    "Bash(docker ps:*)",
    "Bash(docker rm:*)",
    "Bash(docker run:*)",
    "Bash(docker stop:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)",
    "Bash(git status:*)",
    "Bash(lsof:*)",
    "Bash(mongosh:*)",
    "Bash(node \"${CLAUDE_PLUGIN_ROOT}/scripts/*)",
    "Bash(node ${CLAUDE_PLUGIN_ROOT}/scripts/*)",
    "Bash(npx lerna:*)",
    "Bash(pip install:*)",
    "Bash(pkill:*)"
  ],
  "permissions": [
    {
      "pattern": "Bash(npm install:*)",
      "description": "Install npm dependencies before starting project for screenshots",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run dev:*)",
      "description": "Start development server for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run build:*)",
      "description": "Build project before screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
