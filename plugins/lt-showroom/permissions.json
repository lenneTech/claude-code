{
  "$schema": "./permissions.schema.json",
  "description": "Bash permissions for the showroom plugin. Covers source code analysis, project startup for screenshots, and API health checks.",
  "formerPatterns": [
    "Bash(cp *.env*)",
    "Bash(curl *api.showroom.lenne.tech*)",
    "Bash(curl *localhost*)",
    "Bash(docker rm:*)",
    "Bash(docker run:*)",
    "Bash(docker stop:*)",
    "Bash(mongosh:*)",
    "Bash(pip install:*)",
    "Bash(pkill:*)"
  ],
  "permissions": [
    {
      "pattern": "Bash(git log:*)",
      "description": "Read git history for project analysis",
      "usedBy": [
        "analyzing-projects",
        "project-analyzer",
        "showroom:analyze",
        "showroom:create",
        "showroom:update"
      ]
    },
    {
      "pattern": "Bash(git status:*)",
      "description": "Check git working tree status for project analysis",
      "usedBy": [
        "analyzing-projects",
        "project-analyzer",
        "showroom:analyze"
      ]
    },
    {
      "pattern": "Bash(git diff:*)",
      "description": "Compare versions for project analysis",
      "usedBy": [
        "analyzing-projects",
        "project-analyzer",
        "showroom:analyze"
      ]
    },
    {
      "pattern": "Bash(npm install:*)",
      "description": "Install npm dependencies before starting project for screenshots",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run dev:*)",
      "description": "Start development server for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run build:*)",
      "description": "Build project before screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run seed:*)",
      "description": "Seed demo data for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run start:*)",
      "description": "Start project in production mode for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(pnpm install:*)",
      "description": "Install pnpm dependencies before starting project for screenshots",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(pnpm run dev:*)",
      "description": "Start development server via pnpm for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(pnpm run build:*)",
      "description": "Build project via pnpm before screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(pnpm run seed:*)",
      "description": "Seed demo data via pnpm for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(pnpm run start:*)",
      "description": "Start project via pnpm in production mode for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(yarn install:*)",
      "description": "Install yarn dependencies before starting project for screenshots",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(yarn run dev:*)",
      "description": "Start development server via yarn for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(yarn run build:*)",
      "description": "Build project via yarn before screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(yarn run seed:*)",
      "description": "Seed demo data via yarn for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(yarn run start:*)",
      "description": "Start project via yarn in production mode for screenshot capture",
      "usedBy": [
        "creating-showcases",
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(lsof:*)",
      "description": "Check whether a port is taken before starting a project for screenshots (read only; the owner is never stopped)",
      "usedBy": [
        "screenshot-generator"
      ]
    },
    {
      "pattern": "Bash(mkdir -p docs/showcase*)",
      "description": "Create the docs/showcase/ folder for a monorepo SHOWCASE.md",
      "usedBy": [
        "analyzing-projects",
        "project-analyzer",
        "showroom:analyze"
      ]
    },
    {
      "pattern": "Bash(npx lerna:*)",
      "description": "Run lerna commands for monorepo projects",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npx nuxt:*)",
      "description": "Run nuxt commands directly via npx",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(uvicorn:*)",
      "description": "Start Python FastAPI services",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(cp .env.example .env)",
      "description": "Copy .env.example to .env for project setup",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(docker ps:*)",
      "description": "Check running Docker containers",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(npm run migrate:*)",
      "description": "Run database migrations",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(pnpm run migrate:*)",
      "description": "Run database migrations (pnpm)",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot"
      ]
    },
    {
      "pattern": "Bash(node ${CLAUDE_PLUGIN_ROOT}/scripts/*)",
      "description": "Run the plugin scripts (screenshot-session.mjs: work folder, session record, database check, manifest, cleanup)",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot",
        "showroom:create",
        "creating-showcases"
      ]
    },
    {
      "pattern": "Bash(node \"${CLAUDE_PLUGIN_ROOT}/scripts/*)",
      "description": "The same scripts with the placeholder quoted, the form the plugin uses so a home path with spaces survives. Bash rules match the literal command text, so the unquoted pattern does not cover it",
      "usedBy": [
        "screenshot-generator",
        "showroom:screenshot",
        "showroom:create",
        "creating-showcases"
      ]
    },
    {
      "pattern": "Bash(docker compose -p showroom-*)",
      "description": "Start a screenshot run Compose stack under its own project name (recorded and taken down by cleanup)",
      "usedBy": [
        "screenshot-generator",
        "creating-showcases"
      ]
    },
    {
      "pattern": "Bash(lt ticket start:*)",
      "description": "Start an lt project for screenshots as an isolated stack (own URLs, ports and database) from the throwaway clone",
      "usedBy": [
        "screenshot-generator",
        "creating-showcases"
      ]
    },
    {
      "pattern": "Bash(TMPDIR=/tmp lt ticket start:*)",
      "description": "The same with a short TMPDIR, which keeps Nuxt SSR under lt dev from crashing on the macOS socket-path limit",
      "usedBy": [
        "screenshot-generator"
      ]
    },
    {
      "pattern": "Bash(lt dev status:*)",
      "description": "Read the URLs and processes of the screenshot run lt stack",
      "usedBy": [
        "screenshot-generator"
      ]
    },
    {
      "pattern": "Bash(lt dev doctor:*)",
      "description": "Check that lt dev (Caddy) is set up before choosing the lt route",
      "usedBy": [
        "screenshot-generator"
      ]
    },
    {
      "pattern": "Bash(cwebp:*)",
      "description": "Convert older PNG screenshots to WebP for the fallback chain",
      "usedBy": [
        "screenshot-generator"
      ]
    },
    {
      "pattern": "Bash(TMPDIR=/tmp lt dev up --no-prune:*)",
      "description": "Start the screenshot run's lt ticket stack without the prune of the developer's other environments",
      "usedBy": [
        "screenshot-generator"
      ]
    },
    {
      "pattern": "Bash(lt dev up --no-prune:*)",
      "description": "The same without the short TMPDIR",
      "usedBy": [
        "screenshot-generator"
      ]
    }
  ]
}
