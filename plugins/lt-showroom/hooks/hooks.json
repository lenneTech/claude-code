{
  "description": "Detects analyzable software projects with showcase intent to activate the relevant skills, re-injects showcase context after compaction, and cleans up screenshot runs when a session ends",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-analyzable-project.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting analyzable project context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-compact-context.sh\"",
            "timeout": 5,
            "statusMessage": "Re-injecting showroom context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sweep-screenshot-sessions.sh\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
